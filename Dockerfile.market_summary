FROM python:3.11-slim

# ================================
# System setup
# ================================
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false

WORKDIR /app

# Build tools for any C-extension wheels (e.g. langchain deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
 && rm -rf /var/lib/apt/lists/*


# ================================
# Python dependencies
# ================================
# Copy requirements first for layer caching.
# build context = project root (this Dockerfile sits at repo root).
COPY requirements_v0-market_summary.txt ./requirements.txt
RUN pip install --upgrade pip && \
    pip install -r requirements.txt


# ================================
# Application code
# ================================
# v0 Market Summary lives under src/market_summary/ and the streamlit app
# imports siblings as `from config import ...`, so we must run from inside
# that folder.
# - src/market_summary/ : streamlit app + advisor + document_pipeline + config
# - data/market_summary/: source PDFs for the RAG vector store
COPY src/market_summary/ ./src/market_summary/
COPY data/market_summary/ ./data/market_summary/

EXPOSE 8501


# ================================
# Run Streamlit app
# ================================
# Step into src/market_summary so same-folder imports resolve.
WORKDIR /app/src/market_summary

# Expect OPENAI_API_KEY (and any other RAG secrets) at runtime via --env-file.
CMD ["streamlit", "run", "app_streamlit.py", "--server.port=8501", "--server.address=0.0.0.0"]
