# =====================================================================
# trading-advisor — .env.example
# =====================================================================
# Usage:
#   1) cp .env.example .env
#   2) Fill in your own values for each variable you actually need.
#      (v0 only? you can leave the v1 block empty. v1 only? leave v0 empty.)
#   3) .env is in .gitignore — never commit.
#
# For Cloud Run deployment, register these variables in Google Secret
# Manager and inject them as service env vars. No code change needed.
# =====================================================================


# =====================================================================
# v0 — AI Stock Market Analyst (RAG / Streamlit)
# =====================================================================
# Only the OpenAI key is required for v0. The Streamlit app reads it from
# the environment on startup.
OPENAI_API_KEY=sk-...


# =====================================================================
# v1 — Anomaly Detection Daemon
# =====================================================================

# ---------------------------------------------------------------------
# Email — Gmail SMTP (primary alert channel: RISK_OFF + EMERGENCY)
# ---------------------------------------------------------------------
# Gmail "App Password" required (NOT your normal Google password).
# Issue one here: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=youraccount@gmail.com
SMTP_TO=recipient@example.com

# ---------------------------------------------------------------------
# Telegram — EMERGENCY-only alert channel
# ---------------------------------------------------------------------
# 1) Create a new bot via @BotFather → receive a bot token.
# 2) Send any message to your bot, then call:
#       https://api.telegram.org/bot<TOKEN>/getUpdates
#    → look for "chat": { "id": ... } in the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# CME — Databento (paid PAYG, daily cost cap is enforced in code)
# ---------------------------------------------------------------------
DATABENTO_API_KEY=

# Optional — TradingView webhook signature secret (CME enricher)
# Random string of your choice (must match what you set in TradingView).
TRADINGVIEW_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Polymarket — Dune Analytics (historical backfill only; live trades use
# Polymarket's own public CLOB API which needs no key)
# ---------------------------------------------------------------------
DUNE_API_KEY=
DUNE_QUERY_ID_POLYMARKET_TRADES=

# ---------------------------------------------------------------------
# X (Twitter) — channel collector (read) + auto-post (write)
# ---------------------------------------------------------------------
# Bearer token = read endpoints (timeline, recent search).
# OAuth1.0a quartet = write endpoint (tweet posting). All four are required
# for write; pass the same app's "Read & Write" credentials.
# Create at https://developer.twitter.com/en/portal/dashboard.
X_API_BEARER_TOKEN=
X_API_KEY=
X_API_KEY_SECRET=
X_API_ACCESS_TOKEN=
X_API_ACCESS_TOKEN_SECRET=

# ---------------------------------------------------------------------
# Unusual Whales (optional — CME flow context for `cme_enricher`)
# ---------------------------------------------------------------------
UNUSUALWHALES_API_KEY=


# =====================================================================
# v1 — Runtime toggles (optional; defaults are listed)
# =====================================================================
# Where the daemon writes its rolling buffers / decision log.
# Cloud Run revisions reset on every deploy, so /tmp is fine there.
# For local dev, point at any writable directory.
ANOMALY_DATA_PATH=/tmp/anomaly-data

# CME insider scanner — 24/7 background task that runs ES/BZ/CL detectors
# off GCS Parquet. Set to "false" to disable the scanner without touching
# the channel pollers.
ENABLE_CME_INSIDER_SCANNER=true
CME_GCS_BUCKET=anomaly-cme-trades

# X auto-post (EMERGENCY only) — production default ON.
# Set ENABLE_X_AUTO_POST=false to disable entirely.
# Set X_POST_DRY_RUN=true to render the thread but skip the API call
# (useful when iterating locally).
ENABLE_X_AUTO_POST=true
X_POST_DRY_RUN=false

# X channel real collector (Lookonchain / unusual_whales feed).
#   true  → MockXCollector (5 sample posts, $0)
#   false → real XCollector (X API v2 Bearer; PAYG ~$8/mo)
X_USE_MOCK_COLLECTOR=false
