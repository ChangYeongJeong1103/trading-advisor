*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal

# LLM embedding cache (regenerated locally)
data/anomaly_detection/truthsocial/.cache/

# One-time wayback validation reports (not part of the reference DB)
